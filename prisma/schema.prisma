// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Required models for @auth/prisma-adapter

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  sources       Source[]
  ingestionJobs IngestionJob[]
  chats         Chat[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Required models for Ingestion

model Source {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url        String
  title      String?
  crawlDepth Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs IngestionJob[]
}

enum IngestionJobStatus {
  PENDING
  CRAWLING
  VECTORIZING
  COMPLETED
  FAILED
}

model IngestionJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  status       IngestionJobStatus @default(PENDING)
  errorMessage String?

  totalPages  Int @default(0)
  processedPages Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  chats Chat[]
}

model Chat {
  id    String @id @default(cuid())
  jobId String
  job   IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id       String @id @default(cuid())
  chatId   String
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role    String // "user" or "assistant"
  content String @db.Text

  createdAt DateTime @default(now())
}

// Embeddings

model Document {
  id        String   @id @default(cuid())
  content   String
  metadata  Json     @default("{}")
  // Store the 384-dimensional vector from HuggingFace
  embedding Unsupported("vector(384)")? 
  createdAt DateTime @default(now())
}
